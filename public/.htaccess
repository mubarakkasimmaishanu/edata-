<IfModule mod_headers.c>
  # index.html must never be cached by browser or proxy so deployments take effect immediately
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, proxy-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Fingerprinted Vite assets are cached permanently
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  RewriteCond %{REQUEST_URI} ^/edata/app/
  RewriteRule ^ - [E=BASE_PATH:/edata/app/]
  RewriteCond %{ENV:BASE_PATH} ^$
  RewriteRule ^ - [E=BASE_PATH:/app/]

  # If requested resource exists as a real file or dir, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never serve HTML for missing static assets (return clean 404 so Vite preload error fires)
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Route all other SPA routes to index.html
  RewriteRule . index.html [L]
</IfModule>
